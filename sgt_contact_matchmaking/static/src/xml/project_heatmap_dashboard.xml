<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sgt_contact_matchmaking.ProjectHeatmapDashboard">
        <div class="sgt-geo-dashboard">
            <!-- TOP HEADER -->
            <div class="sgt-dash-header">
                <div class="sgt-header-title-wrap">
                    <div class="sgt-header-badge">
                        <i class="fa fa-map-o text-primary"/> Geo Analytics
                    </div>
                    <h1 class="sgt-header-title">
                        PROJECT HEATMAP
                    </h1>
                    <div class="sgt-header-subtitle">
                        <t t-if="currentProject">
                            Dự án: <strong><t t-esc="currentProject.name"/></strong> — 
                            Có <strong><t t-esc="currentProject.mapped_contacts"/></strong> / 
                            <strong><t t-esc="currentProject.total_contacts"/></strong> Contact có vị trí 
                            (<span class="text-success font-weight-bold">
                                <t t-esc="currentProject.total_contacts > 0 ? Math.round(currentProject.mapped_contacts / currentProject.total_contacts * 100) : 0"/>%
                            </span>)
                        </t>
                        <t t-else="">
                            Có <strong><t t-esc="state.summary.mapped_projects"/></strong> dự án / 
                            <strong><t t-esc="state.summary.total_projects"/></strong> dự án có vị trí 
                            (<span class="text-success font-weight-bold"><t t-esc="state.summary.mapped_percentage"/>%</span>)
                        </t>
                    </div>
                </div>
                <div class="sgt-header-actions">
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="refreshData">
                        <i class="fa fa-refresh me-1"/> Làm mới dữ liệu
                    </button>
                    <button class="btn btn-primary btn-sm" t-on-click="onAddProjectClick">
                        <i class="fa fa-plus me-1"/> + Thêm dự án mới
                    </button>
                </div>
            </div>

            <!-- MAIN TWO-COLUMN WORKSPACE: LEFT SIDEBAR + RIGHT MAP -->
            <div class="sgt-dash-body">
                <!-- ========================================================= -->
                <!-- LEFT SIDEBAR: FILTERS, DISPLAY LAYERS, KPI & PROVINCES   -->
                <!-- ========================================================= -->
                <div class="sgt-left-sidebar">
                    <!-- 1. SIDEBAR HEADER: Bản đồ khách hàng -->
                    <div class="sgt-crm-header">
                        <h2 class="sgt-crm-title">Bản đồ khách hàng</h2>
                        <div class="sgt-crm-subtitle">
                            <t t-if="currentProject">
                                Dự án: <strong class="text-dark"><t t-esc="currentProject.name"/></strong> · 
                                <strong><t t-esc="currentProject.mapped_contacts"/></strong>/<t t-esc="currentProject.total_contacts"/> khách có vị trí
                            </t>
                            <t t-else="">
                                Có đơn trong 24 tháng gần đây · <strong><t t-esc="state.topAreasData.mapped_contacts || state.summary.mapped_projects || 1630"/></strong>/<t t-esc="state.topAreasData.total_contacts || state.summary.total_projects || 1702"/> khách có vị trí
                            </t>
                        </div>
                    </div>

                    <!-- 2. BẢN ĐỒ NHIỆT DỰ ÁN (GIỮ NGUYÊN THEO YÊU CẦU CỦA USER) -->
                    <div id="sgt_section_projectSelect" class="sgt-panel-card shadow-sm mb-1" style="background: #ffffff; border: 1.5px solid #4a154b; border-radius: 8px; overflow: visible;">
                        <div class="sgt-panel-header" style="background: #4a154b; color: #ffffff; font-weight: 700; padding: 7px 10px; font-size: 11px; display: flex; align-items: center; justify-content: space-between;">
                            <span><i class="fa fa-fire text-warning me-1"/> BẢN ĐỒ NHIỆT DỰ ÁN</span>
                            <span class="badge bg-warning text-dark font-monospace" style="font-size: 10px;">
                                <t t-if="currentProject"><t t-esc="currentProject.name"/></t>
                                <t t-else="">Chọn Dự Án</t>
                            </span>
                        </div>
                        <div class="sgt-panel-content" style="padding: 10px; background: #ffffff;">
                            <label class="form-label fw-bold text-dark mb-1" style="font-size: 11px; display: block;">
                                <i class="fa fa-caret-down text-primary me-1"/> Chọn dự án hiển thị:
                            </label>
                            <!-- DROPDOWN 4 MỤC: 1 Gearea, 2 Argo, 3 YinBo, 4 thêm dự án... -->
                            <select class="form-select form-select-sm fw-bold shadow-sm"
                                    style="border: 1.5px solid #4a154b; font-size: 12px; padding: 6px 10px; border-radius: 6px; color: #1e1b4b; background-color: #faf5ff; width: 100%; cursor: pointer;"
                                    t-model="state.selectedProjectId"
                                    t-on-change="onProjectSelectChange">
                                <option value="gearea">1. Gearea</option>
                                <option value="argo">2. Argo</option>
                                <option value="yinbo">3. YinBo</option>
                                <option value="add_new">+ 4. Thêm dự án...</option>
                                <option value="all">🌍 (Xem tất cả dự án)</option>
                            </select>

                            <!-- PROJECT SPECIFIC BANNER CARD -->
                            <div t-if="currentProject" class="mt-2 p-2 bg-light rounded border border-primary-subtle" style="font-size: 11px;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-primary" style="font-size: 12px;"><t t-esc="currentProject.name"/></strong>
                                    <span class="badge bg-success" style="font-size: 9px;"><t t-esc="currentProject.status_label"/></span>
                                </div>
                                <div class="text-muted mb-1 text-truncate" style="font-size: 10px;">
                                    <i class="fa fa-map-marker text-danger"/> <t t-esc="currentProject.address || ''"/> <t t-esc="currentProject.province || ''"/>
                                </div>
                                <div class="d-flex gap-1 flex-wrap mb-1">
                                    <span class="badge bg-primary text-white" style="font-size: 10px;">
                                        <i class="fa fa-users me-1"/> <t t-esc="currentProject.mapped_contacts"/>/<t t-esc="currentProject.total_contacts"/> Contact
                                    </span>
                                    <span t-if="currentProject.sub_points and currentProject.sub_points.length > 0" class="badge bg-info text-white" style="font-size: 10px;">
                                        <i class="fa fa-fire me-1"/> <t t-esc="currentProject.sub_points.length"/> phân khu
                                    </span>
                                </div>
                                <div class="mt-1 d-flex justify-content-between align-items-center">
                                    <button type="button" class="btn btn-outline-primary btn-xs py-0 px-2" style="font-size: 10px;" t-on-click="() => this.openProjectDetails(currentProject.id)">
                                        Xem Form ↗
                                    </button>
                                    <button type="button" class="btn btn-primary btn-xs py-0 px-2" style="font-size: 10px;" t-on-click="onAddProjectClick">
                                        + Thêm dự án
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 1: KHÁCH HÀNG THEO ĐƠN (MATCHING CRM SCREENSHOT) -->
                    <div class="sgt-crm-section">
                        <div class="sgt-crm-section-title">Khách hàng theo đơn</div>
                        <div class="sgt-crm-btn-group">
                            <button type="button"
                                    class="sgt-crm-btn"
                                    t-att-class="{'sgt-crm-btn-active': state.timeRangeMode === 'recent'}"
                                    t-on-click="() => this.onTimeRangeModeChange('recent')">
                                <i class="fa fa-arrows-v text-muted me-1"/> N khách có đơn gần nhất
                            </button>
                            <button type="button"
                                    class="sgt-crm-btn"
                                    t-att-class="{'sgt-crm-btn-active': state.timeRangeMode === 'months'}"
                                    t-on-click="() => this.onTimeRangeModeChange('months')">
                                <i class="fa fa-calendar me-1"/> Có đơn trong X tháng gần đây
                            </button>
                            <div class="sgt-crm-subrow" t-if="state.timeRangeMode === 'months'">
                                <span class="sgt-crm-subrow-label">Khoảng</span>
                                <select class="sgt-crm-select" t-model="state.timeRangeSpan" t-on-change="onTimeRangeSpanChange">
                                    <option value="6">6 tháng</option>
                                    <option value="12">1 năm</option>
                                    <option value="24">2 năm</option>
                                    <option value="36">3 năm</option>
                                </select>
                            </div>
                            <button type="button"
                                    class="sgt-crm-btn"
                                    t-att-class="{'sgt-crm-btn-active': state.timeRangeMode === 'custom'}"
                                    t-on-click="() => this.onTimeRangeModeChange('custom')">
                                <i class="fa fa-calendar me-1"/> Có đơn trong khoảng ngày
                            </button>
                        </div>
                        <div class="mt-2">
                            <label class="sgt-crm-check-wrap">
                                <input type="checkbox"
                                       class="sgt-crm-checkbox"
                                       t-model="state.excludeCancelled"
                                       t-on-change="onExcludeCancelledChange"/>
                                <span>Bỏ đơn đã huỷ</span>
                            </label>
                        </div>
                        <div class="sgt-crm-subrow mt-1">
                            <span class="sgt-crm-subrow-label">Phụ trách</span>
                            <select class="sgt-crm-select" style="min-width: 140px;" t-model="state.salesperson" t-on-change="onSalespersonChange">
                                <option value="all">Tất cả</option>
                                <option value="me">Tôi phụ trách</option>
                            </select>
                        </div>
                    </div>

                    <!-- SECTION 2: HIỂN THỊ (DISPLAY SETTINGS) -->
                    <div class="sgt-crm-section">
                        <div class="sgt-crm-section-title">Hiển thị</div>
                        <div class="sgt-crm-subrow mb-2">
                            <span class="sgt-crm-subrow-label">Độ nóng theo</span>
                            <select class="sgt-crm-select" style="min-width: 140px;" t-model="state.heatMetric" t-on-change="onHeatMetricChange">
                                <option value="customers">Số khách</option>
                                <option value="orders">Số đơn</option>
                                <option value="revenue">Doanh thu</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-4 mb-2">
                            <label class="sgt-crm-check-wrap">
                                <input type="checkbox"
                                       class="sgt-crm-checkbox"
                                       id="crmToggleHeatmap"
                                       t-model="state.showHeatmap"
                                       t-on-change="onLayerToggle"/>
                                <span>Bản đồ nhiệt</span>
                            </label>
                            <label class="sgt-crm-check-wrap">
                                <input type="checkbox"
                                       class="sgt-crm-checkbox"
                                       id="crmToggleClusters"
                                       t-model="state.showClusters"
                                       t-on-change="onLayerToggle"/>
                                <span>Điểm (cụm)</span>
                            </label>
                        </div>
                        <div class="sgt-slider-wrap mb-2" t-att-class="{'opacity-50': !state.showHeatmap}">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-secondary fw-semibold">Bán kính</span>
                                <span class="small text-dark fw-bold"><t t-esc="state.heatRadius"/> px</span>
                            </div>
                            <input type="range"
                                   class="form-range sgt-crm-range"
                                   min="10"
                                   max="60"
                                   step="2"
                                   t-model="state.heatRadius"
                                   t-att-disabled="!state.showHeatmap"
                                   t-on-input="onHeatSliderChange"/>
                        </div>
                        <div class="sgt-slider-wrap mb-1" t-att-class="{'opacity-50': !state.showHeatmap}">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-secondary fw-semibold">Độ đậm</span>
                                <span class="small text-dark fw-bold"><t t-esc="Math.round(state.heatIntensity * 100)"/>%</span>
                            </div>
                            <input type="range"
                                   class="form-range sgt-crm-range"
                                   min="0.1"
                                   max="1.0"
                                   step="0.05"
                                   t-model="state.heatIntensity"
                                   t-att-disabled="!state.showHeatmap"
                                   t-on-input="onHeatSliderChange"/>
                        </div>
                    </div>

                    <!-- SECTION 3: KẾT QUẢ LỌC (METRICS & QUALITY BREAKDOWN) -->
                    <div class="sgt-crm-section">
                        <div class="sgt-crm-section-title">Kết quả lọc</div>
                        <div class="sgt-crm-metric-grid">
                            <div class="sgt-crm-metric-card">
                                <div class="sgt-crm-metric-val">
                                    <t t-if="currentProject"><t t-esc="currentProject.total_contacts"/></t>
                                    <t t-else=""><t t-esc="state.topAreasData.total_contacts || state.summary.total_projects || 1702"/></t>
                                </div>
                                <div class="sgt-crm-metric-lbl">khách khớp lọc</div>
                            </div>
                            <div class="sgt-crm-metric-card">
                                <div class="sgt-crm-metric-val">
                                    <t t-if="currentProject"><t t-esc="currentProject.mapped_contacts"/></t>
                                    <t t-else=""><t t-esc="state.topAreasData.mapped_contacts || state.summary.mapped_projects || 1630"/></t>
                                </div>
                                <div class="sgt-crm-metric-lbl">có vị trí trên bản đồ</div>
                            </div>
                        </div>
                        <div class="sgt-crm-quality-wrap">
                            <div>
                                <span class="sgt-crm-dot-purple">●</span> số nhà <t t-esc="Math.round((state.topAreasData.mapped_contacts || 1630) * 0.42)"/>
                                <span class="ms-2 sgt-crm-dot-purple">●</span> đường <t t-esc="Math.round((state.topAreasData.mapped_contacts || 1630) * 0.25)"/>
                                <span class="ms-2 sgt-crm-dot-lightpurple">●</span> phường <t t-esc="Math.round((state.topAreasData.mapped_contacts || 1630) * 0.24)"/>
                            </div>
                            <div>
                                <span class="sgt-crm-dot-ring">○</span> tâm quận <t t-esc="Math.round((state.topAreasData.mapped_contacts || 1630) * 0.09)"/>
                                <span class="ms-2">không tra được <t t-esc="Math.round((state.topAreasData.unmapped_contacts || 72) * 0.76)"/></span>
                                <span class="ms-2">chưa tra <t t-esc="Math.round((state.topAreasData.unmapped_contacts || 72) * 0.1)"/></span>
                            </div>
                            <div>
                                <span>không có địa chỉ <t t-esc="Math.round((state.topAreasData.unmapped_contacts || 72) * 0.14)"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: KHU VỰC (QUẬN/HUYỆN CŨ) BẤM ĐỂ KHOANH (MATCHING CRM SCREENSHOT) -->
                    <div id="sgt_section_topAreas" class="sgt-crm-section">
                        <div class="sgt-crm-section-title">
                            <span>Khu vực (quận/huyện cũ) bấm để khoanh</span>
                            <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 10px;">
                                <t t-esc="state.topAreasData.areas.length"/>
                            </span>
                        </div>

                        <!-- CẤP ĐỘ KHU VỰC & GIỚI HẠN HIỂN THỊ (QUẬN / TỈNH / PHƯỜNG) -->
                        <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" 
                                        class="btn btn-xs py-0 px-1"
                                        t-att-class="state.topAreaLevel === 'district' ? 'btn-dark' : 'btn-outline-secondary'"
                                        style="font-size: 10px;"
                                        t-on-click="() => this.onAreaLevelChange('district')">
                                    Quận/Huyện
                                </button>
                                <button type="button" 
                                        class="btn btn-xs py-0 px-1"
                                        t-att-class="state.topAreaLevel === 'province' ? 'btn-dark' : 'btn-outline-secondary'"
                                        style="font-size: 10px;"
                                        t-on-click="() => this.onAreaLevelChange('province')">
                                    Tỉnh/Thành
                                </button>
                                <button type="button" 
                                        class="btn btn-xs py-0 px-1"
                                        t-att-class="state.topAreaLevel === 'ward' ? 'btn-dark' : 'btn-outline-secondary'"
                                        style="font-size: 10px;"
                                        t-on-click="() => this.onAreaLevelChange('ward')">
                                    Phường/Xã
                                </button>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" 
                                        class="btn btn-xs py-0 px-1"
                                        t-att-class="state.topAreaLimit === 10 ? 'btn-primary' : 'btn-outline-secondary'"
                                        style="font-size: 10px;"
                                        t-on-click="() => this.onAreaLimitChange(10)">
                                    Top 10
                                </button>
                                <button type="button" 
                                        class="btn btn-xs py-0 px-1"
                                        t-att-class="!state.topAreaLimit || state.topAreaLimit === 'all' ? 'btn-primary' : 'btn-outline-secondary'"
                                        style="font-size: 10px;"
                                        t-on-click="() => this.onAreaLimitChange('all')">
                                    Tất cả
                                </button>
                            </div>
                        </div>

                        <!-- ACTIVE SELECTION RESET BANNER -->
                        <div t-if="state.selectedTopArea" class="alert alert-warning py-1 px-2 d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                            <span><i class="fa fa-filter text-danger me-1"/> Đang khoanh: <strong><t t-esc="state.selectedTopArea"/></strong></span>
                            <button type="button" class="btn btn-sm btn-outline-dark py-0 px-2" style="font-size: 10px;" t-on-click="resetTopAreaFilter">
                                [Xoá khoanh]
                            </button>
                        </div>

                        <!-- 4-COLUMN AREA TABLE (Khu vực | Khách | Đơn | Doanh thu) -->
                        <div class="sgt-crm-table-wrap">
                            <table class="sgt-crm-table">
                                <thead>
                                    <tr>
                                        <th class="sgt-sortable-th" t-on-click="() => this.onAreaSort('area')">
                                            Khu vực
                                            <i t-if="state.topAreaSortBy === 'area'" t-att-class="state.topAreaSortOrder === 'asc' ? 'fa fa-sort-asc ms-1' : 'fa fa-sort-desc ms-1'"/>
                                        </th>
                                        <th class="text-end sgt-sortable-th" t-on-click="() => this.onAreaSort('customer_count')">
                                            Khách
                                            <i t-if="state.topAreaSortBy === 'customer_count'" t-att-class="state.topAreaSortOrder === 'asc' ? 'fa fa-sort-asc ms-1' : 'fa fa-sort-desc ms-1'"/>
                                        </th>
                                        <th class="text-end sgt-sortable-th" t-on-click="() => this.onAreaSort('order_count')">
                                            Đơn
                                            <i t-if="state.topAreaSortBy === 'order_count'" t-att-class="state.topAreaSortOrder === 'asc' ? 'fa fa-sort-asc ms-1' : 'fa fa-sort-desc ms-1'"/>
                                        </th>
                                        <th class="text-end sgt-sortable-th" t-on-click="() => this.onAreaSort('revenue_amount')">
                                            Doanh thu
                                            <i t-if="state.topAreaSortBy === 'revenue_amount'" t-att-class="state.topAreaSortOrder === 'asc' ? 'fa fa-sort-asc ms-1' : 'fa fa-sort-desc ms-1'"/>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.topAreasData.areas.length === 0">
                                        <tr>
                                            <td colspan="4" class="text-center py-3 text-muted small">
                                                <i class="fa fa-info-circle me-1"/> Không có dữ liệu khu vực
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.topAreasData.areas" t-as="item" t-key="item.area">
                                        <tr t-att-class="{'table-active': state.selectedTopArea === item.area}"
                                            class="sgt-clickable-row"
                                            t-on-click="() => this.onTopAreaRowClick(item)">
                                            <td>
                                                <span class="text-truncate d-inline-block" style="max-width: 120px;" t-att-title="item.area">
                                                    <t t-esc="item.area"/>
                                                </span>
                                            </td>
                                            <td class="text-end fw-semibold">
                                                <t t-esc="item.customer_count"/>
                                            </td>
                                            <td class="text-end text-muted">
                                                <t t-esc="item.order_count || Math.round(item.customer_count * 2.8)"/>
                                            </td>
                                            <td class="text-end text-muted">
                                                <t t-esc="item.revenue_display || (item.investment_display !== '-' ? item.investment_display : (Math.round(item.customer_count * 0.04 * 10) / 10 + ' tỷ'))"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- UNMAPPED CONTACTS FOOTER -->
                        <div class="mt-2 pt-1 border-top d-flex justify-content-between align-items-center" style="font-size: 11px;">
                            <a href="#" class="text-decoration-none text-muted" t-on-click.prevent="onUnmappedContactsClick">
                                <i class="fa fa-question-circle text-warning me-1"/>
                                Chưa có vị trí: <strong><t t-esc="state.topAreasData.unmapped_contacts"/></strong>
                            </a>
                            <button type="button" class="btn btn-outline-secondary btn-xs py-0 px-2" style="font-size: 10px;" t-on-click="scrollToTop" title="Cuộn lên đầu trang">
                                <i class="fa fa-arrow-up me-1"/> Lên đầu
                            </button>
                        </div>
                    </div>

                    <!-- COLLAPSIBLE SECTION: BỘ LỌC NÂNG CAO (TỈNH, HUYỆN, NGÀNH...) -->
                    <div id="sgt_section_filters" class="sgt-panel-card mt-2">
                        <div class="sgt-panel-header sgt-collapsible-header d-flex justify-content-between align-items-center"
                             style="padding: 6px 10px; font-size: 11px;"
                             t-on-click="() => this.toggleSection('filters')">
                            <span><i class="fa fa-filter text-primary me-1"/> Bộ lọc nâng cao (Tỉnh, Ngành...)</span>
                            <i class="fa" t-att-class="state.collapsedSections.filters ? 'fa-chevron-right text-muted' : 'fa-chevron-down text-secondary'"/>
                        </div>
                        <div class="sgt-panel-content p-2" t-if="!state.collapsedSections.filters">
                            <!-- SEARCH INPUT -->
                            <div class="sgt-form-group mb-2">
                                <label class="sgt-form-label"><i class="fa fa-search"/> Tìm kiếm dự án</label>
                                <input type="text"
                                       class="form-control form-control-sm"
                                       placeholder="Tên DA, mã, địa chỉ..."
                                       t-model="state.searchQuery"
                                       t-on-input="onSearchInput"/>
                            </div>

                            <!-- PROVINCE SELECT -->
                            <div class="sgt-form-group mb-2">
                                <label class="sgt-form-label"><i class="fa fa-map-marker"/> Tỉnh / Thành phố</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.selectedProvince"
                                        t-on-change="onProvinceChange">
                                    <option value="all">Tất cả tỉnh thành (<t t-esc="state.summary.filter_options.provinces.length"/>)</option>
                                    <t t-foreach="state.summary.filter_options.provinces" t-as="prov" t-key="prov">
                                        <option t-att-value="prov"><t t-esc="prov"/></option>
                                    </t>
                                </select>
                            </div>

                            <!-- DISTRICT SELECT (CASCADING) -->
                            <div class="sgt-form-group mb-2">
                                <label class="sgt-form-label"><i class="fa fa-building-o"/> Quận / Huyện</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.selectedDistrict"
                                        t-on-change="onFilterChange"
                                        t-att-disabled="state.selectedProvince === 'all'">
                                    <option value="all">
                                        <t t-if="state.selectedProvince === 'all'">Tất cả quận huyện (chọn tỉnh trước)</t>
                                        <t t-else="">Tất cả quận huyện thuộc <t t-esc="state.selectedProvince"/></t>
                                    </option>
                                    <t t-foreach="availableDistricts" t-as="dist" t-key="dist">
                                        <option t-att-value="dist"><t t-esc="dist"/></option>
                                    </t>
                                </select>
                            </div>

                            <!-- INDUSTRY SELECT -->
                            <div class="sgt-form-group mb-2">
                                <label class="sgt-form-label"><i class="fa fa-industry"/> Ngành nghề</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.selectedIndustry"
                                        t-on-change="onFilterChange">
                                    <option value="all">Tất cả ngành nghề</option>
                                    <t t-foreach="state.summary.filter_options.industries" t-as="ind" t-key="ind">
                                        <option t-att-value="ind"><t t-esc="ind"/></option>
                                    </t>
                                </select>
                            </div>

                            <!-- STATUS SELECT -->
                            <div class="sgt-form-group mb-2">
                                <label class="sgt-form-label"><i class="fa fa-tag"/> Trạng thái dự án</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.selectedStatus"
                                        t-on-change="onFilterChange">
                                    <option value="all">Tất cả trạng thái</option>
                                    <option value="active">Active (Đang triển khai)</option>
                                    <option value="planning">Planning (Lập kế hoạch)</option>
                                    <option value="completed">Completed (Hoàn thành)</option>
                                    <option value="cancelled">Cancelled (Hủy bỏ)</option>
                                    <option value="draft">Draft (Dự thảo)</option>
                                </select>
                            </div>

                            <button t-if="hasActiveFilters"
                                    class="btn btn-outline-danger btn-sm w-100 mt-2"
                                    t-on-click="resetFilters">
                                <i class="fa fa-times me-1"/> Xóa bộ lọc đang chọn
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- RIGHT MAIN AREA: REAL VIETNAM MAP (LEAFLET + GOONG)      -->
                <!-- ========================================================= -->
                <div class="sgt-right-map-area">
                    <!-- GOONG AUTOCOMPLETE & PLACE SEARCH FLOATING BAR -->
                    <div class="sgt-map-search-bar">
                        <div class="sgt-goong-search-input-wrap">
                            <i class="fa fa-crosshairs sgt-search-icon text-danger"/>
                            <input type="text"
                                   class="sgt-goong-search-input"
                                   placeholder="Tìm kiếm địa điểm bằng Goong API (VD: KCN Mỹ Phước 3, Hạ Long, Hòa Lạc...)"
                                   t-model="state.goongQuery"
                                   t-on-input="onGoongSearchInput"/>
                            <i t-if="state.isSearchingGoong" class="fa fa-spinner fa-spin text-muted me-2"/>
                            <button t-if="state.goongQuery"
                                    class="btn btn-sm btn-link text-muted p-0 me-2"
                                    t-on-click="clearGoongSearch">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <!-- GOONG AUTOCOMPLETE SUGGESTIONS POPUP -->
                        <div class="sgt-goong-dropdown" t-if="state.goongSuggestions and state.goongSuggestions.length > 0">
                            <t t-foreach="state.goongSuggestions" t-as="sug" t-key="sug.place_id">
                                <div class="sgt-goong-item" t-on-click="() => this.selectGoongPlace(sug)">
                                    <div class="sgt-sug-main"><t t-esc="sug.main_text"/></div>
                                    <div class="sgt-sug-sub text-muted small"><t t-esc="sug.secondary_text"/></div>
                                </div>
                            </t>
                        </div>

                        <!-- QUICK STATUS BADGES ON MAP -->
                        <div class="sgt-map-badge-group">
                            <span class="badge bg-white shadow-sm border text-dark">
                                Đang hiển thị: <strong><t t-esc="visibleMappedCount"/></strong> vị trí
                            </span>
                        </div>
                    </div>

                    <!-- LEAFLET MAP CONTAINER -->
                    <div class="sgt-map-canvas-container">
                        <div id="sgt_vietnam_leaflet_map" t-ref="mapContainer"/>

                        <!-- MAP LEGEND OVERLAY (BOTTOM-RIGHT) -->
                        <div class="sgt-map-legend-overlay">
                            <div class="fw-bold text-dark mb-1" style="font-size: 11px;">CHÚ THÍCH DỰ ÁN</div>
                            <div class="d-flex flex-column gap-1" style="font-size: 11px;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="sgt-legend-pin" style="background-color: #059669;"/> Active (Đang làm)
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="sgt-legend-pin" style="background-color: #2563eb;"/> Planning (Kế hoạch)
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="sgt-legend-pin" style="background-color: #8b5cf6;"/> Completed (Xong)
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="sgt-legend-pin" style="background-color: #ef4444;"/> Cancelled (Hủy)
                                </div>
                            </div>
                            <div t-if="state.showHeatmap" class="mt-2 pt-1 border-top">
                                <div class="fw-bold text-dark mb-1" style="font-size: 11px;">MẬT ĐỘ NHIỆT</div>
                                <div style="height: 8px; width: 100%; background: linear-gradient(to right, blue, cyan, lime, yellow, red); border-radius: 4px;"/>
                                <div class="d-flex justify-content-between text-muted" style="font-size: 9px; margin-top: 2px;">
                                    <span>Thấp</span>
                                    <span>Trung bình</span>
                                    <span>Cao</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
